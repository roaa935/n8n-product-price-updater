    {
      "parameters": {
        "jsCode": "\nconst message = $input.first().json.message;\nconst text = message?.text ?? '';\n\nconst match = text.trim().match(/^(.+?)\\s+(\\d+(?:\\.\\d+)?)%$/);\n\nif (!match) {\n  throw new Error('Invalid format. Use: Lenovo 10%');\n}\n\nreturn [{\n  json: {\n    productName: match[1].trim(),\n    percentage: Number(match[2]),\n    chatId: message.chat.id\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        48,
        0
      ],
      "id": "1636c17c-c47e-4ac3-92d1-33254704b2f0",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "\nconst row = $input.first().json;\nconst request = $('Parse Telegram Message').first().json;\n\nconst currentPrice = Number(row.Price);\n\nif (!Number.isFinite(currentPrice)) {\n  throw new Error('Invalid product price');\n}\n\nconst newPrice = Number(\n  (currentPrice * (1 + request.percentage / 100)).toFixed(2)\n);\n\nreturn [{\n  json: {\n    Product: row.Product,\n    Price: newPrice,\n    productName: request.productName,\n    percentage: request.percentage,\n    chatId: request.chatId\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
